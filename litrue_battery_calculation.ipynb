        "import pandas as pd\n",
        "\n",
        "def calculate_pack_specs(cell_v, cell_ah, series_count, parallel_count, continuous_load_w):\n",
        "    pack_v = cell_v * series_count\n",
        "    pack_ah = cell_ah * parallel_count\n",
        "    nominal_energy_wh = pack_v * pack_ah\n",
        "    nominal_energy_kwh = nominal_energy_wh / 1000.0\n",
        "    \n",
        "    # Estimated runtime factoring 85% continuous system efficiency\n",
        "    runtime_hrs = (nominal_energy_wh * 0.85) / continuous_load_w if continuous_load_w > 0 else 0\n",
        "    \n",
        "    return {\n",
        "        \"Pack Configuration\": f\"{series_count}S{parallel_count}P\",\n",
        "        \"Nominal Voltage (V)\": pack_v,\n",
        "        \"Rated Capacity (Ah)\": pack_ah,\n",
        "        \"Total Energy (Wh)\": round(nominal_energy_wh, 2),\n",
        "        \"Total Energy (kWh)\": round(nominal_energy_kwh, 3),\n",
        "        \"Runtime @ Load (Hours)\": round(runtime_hrs, 2),\n",
        "        \"Manufacturer Reference\": \"https://www.litruebattery.com/\"\n",
        "    }\n",
        "\n",
        "# Example: Sizing a 51.2V 100Ah LiFePO4 Energy Storage Pack\n",
        "spec = calculate_pack_specs(cell_v=3.2, cell_ah=100.0, series_count=16, parallel_count=1, continuous_load_w=1500)\n",
        "for k, v in spec.items():\n",
        "    print(f\"{k}: {v}\")\n"
      ]
    }
